{
  "id": "SiteAgentSetup01",
  "name": "SiteAgent 4 - Business Setup",
  "nodes": [
    {
      "id": "00000000-0000-4000-8000-000000000057",
      "name": "Save Business",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "webhookId": "siteagent-save-business",
      "parameters": {
        "httpMethod": "POST",
        "path": "save-business",
        "responseMode": "responseNode",
        "options": {
          "allowedOrigins": "*"
        }
      }
    },
    {
      "id": "00000000-0000-4000-8000-000000000058",
      "name": "Validate Business",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "jsCode": "\r\nconst b = $input.first().json.body || {};\r\nconst s = (v) => String(v ?? '').trim();\r\nconst out = {\r\n  businessId: s(b.businessId), editKey: s(b.editKey),\r\n  name: s(b.name), ownerEmail: s(b.ownerEmail).toLowerCase(), knowledge: s(b.knowledge),\r\n};\r\nout.mode = out.businessId ? 'update' : 'create';\r\nif (out.mode === 'create') {\r\n  const slug = out.name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '').slice(0, 30) || 'biz';\r\n  out.businessId = `${slug}-${Math.random().toString(36).slice(2, 7)}`;\r\n}\r\nconst errors = [];\r\nif (out.name.length < 2) errors.push('Business name is required.');\r\nif (!/^[^\\s@]+@[^\\s@]+\\.[^\\s@]{2,}$/.test(out.ownerEmail)) errors.push('A valid owner email is required.');\r\nif (out.knowledge.length < 80) errors.push('Knowledge base is too short — describe your services, prices and policies (at least a few lines).');\r\nif (out.knowledge.length > 60000) errors.push('Knowledge base is too long (max 60,000 characters).');\r\nreturn [{ json: { ...out, valid: errors.length === 0, error: errors.join(' ') } }];\r\n  "
      }
    },
    {
      "id": "00000000-0000-4000-8000-000000000059",
      "name": "Valid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "00000000-0000-4000-8000-000000000060",
              "leftValue": "={{ $json.valid }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "00000000-0000-4000-8000-000000000061",
      "name": "Upsert Business",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        660,
        -80
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH upd AS (\n  UPDATE businesses SET name = $2, owner_email = $3, knowledge = $4, updated_at = now()\n  WHERE $6 = 'update' AND id = $1 AND edit_key = $5 RETURNING *\n),\nins AS (\n  INSERT INTO businesses (id, name, owner_email, knowledge)\n  SELECT $1, $2, $3, $4 WHERE $6 = 'create' RETURNING *\n)\nSELECT id, name, edit_key FROM upd UNION ALL SELECT id, name, edit_key FROM ins",
        "options": {
          "queryReplacement": "={{ [ $json.businessId, $json.name, $json.ownerEmail, $json.knowledge, $json.editKey, $json.mode ] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "SiteAgentPg00001",
          "name": "SiteAgent Postgres"
        }
      },
      "alwaysOutputData": true
    },
    {
      "id": "00000000-0000-4000-8000-000000000062",
      "name": "Saved?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        880,
        -80
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "00000000-0000-4000-8000-000000000063",
              "leftValue": "={{ !!$json.id }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "00000000-0000-4000-8000-000000000064",
      "name": "Build Snippet",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        -160
      ],
      "parameters": {
        "jsCode": "\nconst b = $input.first().json;\nconst base = $env.SITEAGENT_PUBLIC_URL || 'http://localhost:5678';\nconst js = (v) => JSON.stringify(v);\nconst snippet = [\n  '<link href=\"https://cdn.jsdelivr.net/npm/@n8n/chat@1.41.3/dist/style.css\" rel=\"stylesheet\" />',\n  '<script type=\"module\">',\n  \"  import { createChat } from 'https://cdn.jsdelivr.net/npm/@n8n/chat@1.41.3/dist/chat.bundle.es.js';\",\n  '  createChat({',\n  '    webhookUrl: ' + js(base + '/webhook/siteagent-chat/chat') + ',',\n  '    metadata: { businessId: ' + js(b.id) + ' },',\n  '    showWelcomeScreen: false,',\n  '    initialMessages: [' + js('Hi! 👋 Welcome to ' + b.name + '.') + ', ' + js('Ask me anything about our services, pricing or how we work.') + '],',\n  '    i18n: { en: { title: ' + js(b.name) + \", subtitle: 'Typically replies instantly', footer: '', getStarted: 'New conversation', inputPlaceholder: 'Type your question…' } },\",\n  '  });',\n  '</' + 'script>',\n].join('\\n');\nreturn [{ json: { ok: true, businessId: b.id, editKey: b.edit_key, name: b.name, snippet } }];\n\n"
      }
    },
    {
      "id": "00000000-0000-4000-8000-000000000065",
